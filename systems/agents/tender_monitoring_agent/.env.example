# LLM provider configuration (set one provider key below)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
