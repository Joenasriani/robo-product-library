ADMIN_TOKEN=change-admin-token
DEMO_API_KEY=rm_demo_key_here
DEMO_CLIENT_NAME=RoboMarket Demo
DEMO_CLIENT_EMAIL=demo@robomarket.ae

DB_PATH=data/tender_monitoring.db
CORS_ORIGINS=*
PORT=8007
WORKERS=1
LOG_LEVEL=INFO

