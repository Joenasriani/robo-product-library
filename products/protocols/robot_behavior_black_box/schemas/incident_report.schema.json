{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robomarket.ae/schemas/incident-report.schema.json",
  "title": "Robot Incident Report",
  "type": "object",
  "required": ["incident_id", "related_event_ids", "summary", "severity", "root_cause_hypothesis", "corrective_actions", "review_owner"],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "related_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "summary": {"type": "string", "minLength": 10},
    "severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "root_cause_hypothesis": {"type": "string", "minLength": 5},
    "evidence_needed": {"type": "array", "items": {"type": "string"}},
    "corrective_actions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "sop_update_recommendation": {"type": "string"},
    "review_owner": {"type": "string", "minLength": 2},
    "approval_status": {"type": "string", "enum": ["draft", "under_review", "approved", "rejected"]}
  },
  "additionalProperties": false
}
