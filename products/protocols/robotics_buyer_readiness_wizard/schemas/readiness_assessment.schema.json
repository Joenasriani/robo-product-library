{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Robotics Buyer Readiness Assessment",
  "type": "object",
  "required": ["facility_type", "robot_type", "zones", "human_traffic_patterns", "connectivity_status", "staff_support_model", "maintenance_capacity", "safety_review_owner", "budget_status"],
  "properties": {
    "facility_type": {"type": "string"},
    "robot_type": {"type": "string"},
    "zones": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "human_traffic_patterns": {"type": "string"},
    "connectivity_status": {"type": "string", "enum": ["unknown", "partial", "confirmed", "needs_site_survey"]},
    "staff_support_model": {"type": "string"},
    "maintenance_capacity": {"type": "string", "enum": ["none", "basic", "trained_vendor_support", "internal_robotics_team"]},
    "safety_review_owner": {"type": "string"},
    "budget_status": {"type": "string", "enum": ["unknown", "exploratory", "range_defined", "approved"]}
  },
  "additionalProperties": true
}
