{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robomarket.ae/schemas/robosafe-os/routing_rules.schema.json",
  "title": "RoboSafeOS Routing Rules",
  "type": "object",
  "required": ["facility_type", "robot_type", "zones", "allowed_routes", "restricted_routes", "review_conditions"],
  "properties": {
    "facility_type": { "type": "string" },
    "robot_type": { "type": "string" },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["zone_id", "risk_score", "max_speed_mode", "human_density_assumption"],
        "properties": {
          "zone_id": { "type": "string" },
          "risk_score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "max_speed_mode": { "type": "string", "enum": ["crawl", "slow", "normal"] },
          "human_density_assumption": { "type": "string", "enum": ["low", "medium", "high"] },
          "notes": { "type": "string" }
        }
      }
    },
    "allowed_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route_id", "from_zone", "to_zone", "time_windows"],
        "properties": {
          "route_id": { "type": "string" },
          "from_zone": { "type": "string" },
          "to_zone": { "type": "string" },
          "time_windows": { "type": "array", "items": { "type": "string" } },
          "conditions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "restricted_routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route_id", "reason"],
        "properties": {
          "route_id": { "type": "string" },
          "reason": { "type": "string" },
          "affected_zones": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "fallback_routes": { "type": "array", "items": { "type": "string" } },
    "review_conditions": { "type": "array", "items": { "type": "string" } }
  }
}
