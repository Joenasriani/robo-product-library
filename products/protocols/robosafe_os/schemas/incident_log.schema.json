{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robomarket.ae/schemas/robosafe-os/incident_log.schema.json",
  "title": "RoboSafeOS Incident Log Record",
  "type": "object",
  "required": [
    "incident_id",
    "timestamp",
    "robot_id",
    "zone",
    "task_id",
    "severity",
    "trigger",
    "human_involved",
    "review_used",
    "resolution",
    "follow_up_required"
  ],
  "properties": {
    "incident_id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "robot_id": { "type": "string" },
    "zone": { "type": "string" },
    "task_id": { "type": "string" },
    "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
    "trigger": { "type": "string" },
    "human_involved": { "type": "boolean" },
    "review_used": { "type": "boolean" },
    "resolution": { "type": "string" },
    "evidence_notes": { "type": "string" },
    "follow_up_required": { "type": "boolean" },
    "follow_up_owner": { "type": "string" },
    "closed_at": { "type": "string", "format": "date-time" }
  }
}
