# Copy this file to .env and fill in your values.
# Never commit a real .env to version control.

# BYOK (recommended)
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Demo mode (evaluation only). In CI demos this can be injected from a secret.
DEMO_MODE=false
DEMO_AI_API_KEY=

# Backward compatibility (optional legacy vars)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Server settings
HOST=0.0.0.0
PORT=8000

# Optional tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_K=4
